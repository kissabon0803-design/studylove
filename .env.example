# Vercelのプロジェクト設定 → Environment Variables に登録する値
# （このファイル自体はコミットしない / 値をそのまま貼り付けない）

# --- Groq ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# --- Firebase Admin (サービスアカウント) ---
FIREBASE_PROJECT_ID=studylove-a9351
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@studylove-a9351.iam.gserviceaccount.com
# 秘密鍵は改行を \n に置き換えて1行で登録する
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExxxxxxxxxxxxxxxxxxxx\n-----END PRIVATE KEY-----\n"

# --- CORS ---
# study_love_app.html を配信しているオリジンをカンマ区切りで指定
ALLOWED_ORIGINS=https://studylove-a9351.web.app,https://studylove-a9351.firebaseapp.com
